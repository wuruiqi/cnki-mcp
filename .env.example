# CNKI MCP 配置模板 — 复制为 .env 后按需修改
# 所有路径都有「项目根目录下」的合理默认值，下面的项均为可选覆盖。

# ─── Zotero 云 API（可选，仅本地 connector 不可用时降级使用）───
# 本地 Zotero 桌面端运行时无需填写；填了用于离线降级（仅写元数据）。
ZOTERO_API_KEY=your_zotero_api_key_here
ZOTERO_LIB_ID=your_numeric_library_id_here

# ─── Zotero 本地 connector（推荐，支持 PDF 自动关联）───
ZOTERO_LOCAL_API=http://127.0.0.1:23119

# ─── 路径（默认相对项目根目录，可覆盖为绝对路径）───
# PDF 下载暂存目录（默认 ./downloads；也可指向 Zotero 数据目录便于管理）
# PDF_DIR=D:/your/zotero/cnki_pdfs
# 浏览器持久化 profile（默认 ./.browser_profile）
# PROFILE_DIR=
# CNKI 登录 Cookie 文件（默认 ./.cnki_cookies.json）
# COOKIE_FILE=

# ─── 行为开关 ───
# PDF 成功关联到 Zotero 后是否删除暂存原件（true/false，默认 true）
DELETE_PDF_AFTER_IMPORT=true
